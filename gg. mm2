-- ระบบบันทึกไฟล์
local fileName = "XWackStore_History.json"
local savedScripts = {}

local function loadHistoryFromFile()
    if readfile and isfile and isfile(fileName) then
        local success, result = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(fileName))
        end)
        if success and type(result) == "table" then
            savedScripts = result
        end
    end
end

local function saveHistoryToFile()
    if writefile then
        pcall(function()
            local encoded = game:GetService("HttpService"):JSONEncode(savedScripts)
            writefile(fileName, encoded)
        end)
    end
end

loadHistoryFromFile()

